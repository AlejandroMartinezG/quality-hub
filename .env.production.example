# y rellena los valores reales.
# NUNCA subas este archivo al repositorio.
# ================================================

# --- Supabase Self-Hosted (VPS) ---
# URL de tu instancia Supabase en el VPS:
NEXT_PUBLIC_SUPABASE_URL="http://plataforma-de-control-de-calidad-ginez-s-4cc338-69-62-105-32.traefik.me"

# Clave pública (anon) — obtenida del panel Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY="PEGA_AQUI_TU_ANON_KEY"

# Clave privada (service role) — SOLO server-side, NUNCA en el frontend
SUPABASE_SERVICE_ROLE_KEY="PEGA_AQUI_TU_SERVICE_ROLE_KEY"

